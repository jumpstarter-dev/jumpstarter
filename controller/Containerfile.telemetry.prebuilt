# CI-only runtime image for the jumpstarter-telemetry binary.
#
# The intermediate files stage makes the host-compiled binary executable
# explicitly, independent of the caller's umask. The Makefile also chmods the
# staged binary; this stage protects direct image builds as well.
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8-1792742033@sha256:2d4c4551af6831dcd26bbf86108c4385de5183ec8fe6b5868f6f9640fe47f4ed AS certs
FROM --platform=$BUILDPLATFORM registry.access.redhat.com/ubi9/ubi-minimal:9.8-1792742033@sha256:2d4c4551af6831dcd26bbf86108c4385de5183ec8fe6b5868f6f9640fe47f4ed AS files
COPY telemetry /telemetry
RUN chmod 0755 /telemetry
FROM registry.access.redhat.com/ubi9/ubi-micro:9.8-1791895366@sha256:5be877a2a280ae36eb9ab80ca4efb28bbf77c57abbba38137cdc37a03b8465e6
WORKDIR /
COPY --from=certs /etc/pki/tls/certs/ca-bundle.crt /etc/pki/tls/certs/ca-bundle.crt
COPY --from=files /telemetry /telemetry
USER 65532:65532
ENTRYPOINT ["/telemetry"]
