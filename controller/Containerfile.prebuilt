# CI-only runtime image for host-compiled Go binaries.
#
# BIN selects which binary becomes the default entrypoint.
# COPY ${BIN} /entrypoint works because COPY supports ARG expansion,
# while ENTRYPOINT does not (and ubi-micro has no shell for shell-form).
#
# The intermediate files stage makes every host-compiled binary executable
# explicitly, independent of the caller's umask. The Makefile also chmods the
# staged binaries; this stage protects direct image builds as well.
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.9-1794467051@sha256:baafce2d34783a28b4a472779f304e97e00f9d35c99553bc53b068b14344d9a9 AS certs
FROM --platform=$BUILDPLATFORM registry.access.redhat.com/ubi9/ubi-minimal:9.9-1794467051@sha256:baafce2d34783a28b4a472779f304e97e00f9d35c99553bc53b068b14344d9a9 AS files
ARG BIN
COPY . /stage/
RUN test -n "${BIN}" && chmod 0755 /stage/* "/stage/${BIN}"
FROM registry.access.redhat.com/ubi9/ubi-micro:9.9-1794478307@sha256:dbd325b96bcd432dd42816d31412bdf1dc0fb973b79ed310344bc23c76c068db
ARG BIN
WORKDIR /
COPY --from=certs /etc/pki/tls/certs/ca-bundle.crt /etc/pki/tls/certs/ca-bundle.crt
COPY --from=files /stage/ /
# ENTRYPOINT can't expand ARG; fixed path lets one file serve all three images
COPY --from=files /stage/${BIN} /entrypoint
USER 65532:65532
ENTRYPOINT ["/entrypoint"]
