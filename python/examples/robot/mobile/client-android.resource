*** Settings ***
Documentation    Generated by `jmp robot generate` from the committed nodes table robot.toml [tool.jumpstarter.client.android.nodes] (device Android, session android). Do not edit: regenerating overwrites it.
Library    jumpstarter_robot.Jumpstarter    auto_import=False
Library    jumpstarter_robot.Session    android    exporter_config=${JMP_ANDROID_EXPORTER_CONFIG}    selector=${JMP_ANDROID_SELECTOR}    lease_name=${JMP_ANDROID_LEASE_NAME}    config=${JMP_ANDROID_CLIENT_CONFIG}    AS    session.android
Library    jumpstarter_robot.Driver    emulator    client=jumpstarter_driver_androidemulator.client.AndroidEmulatorClient    prefix=Emulator    session=android    AS    android.emulator
Library    jumpstarter_robot.Driver    emulator.adb    client=jumpstarter_driver_adb.client.AdbClient    prefix=Emulator Adb    session=android    AS    android.emulator.adb
Library    jumpstarter_robot.Driver    emulator.power    client=jumpstarter_driver_power.client.PowerClient    prefix=Device Power    session=android    AS    android.emulator.power
Library    jumpstarter_robot.Driver    emulator.appium    client=jumpstarter_driver_appium.client.AppiumClient    prefix=Appium    session=android    AS    android.emulator.appium

*** Variables ***
${JMP_ANDROID_EXPORTER_CONFIG}    ${CURDIR}/exporter-android.yaml
${JMP_ANDROID_SELECTOR}    ${EMPTY}
${JMP_ANDROID_LEASE_NAME}    ${EMPTY}
${JMP_ANDROID_CLIENT_CONFIG}    ${EMPTY}
