*** Settings ***
Documentation    Generated by `jmp robot generate` from the committed nodes table robot.toml [tool.jumpstarter.client.ios.nodes] (device Ios, session ios). Do not edit: regenerating overwrites it.
Library    jumpstarter_robot.Jumpstarter    auto_import=False
Library    jumpstarter_robot.Session    ios    exporter_config=${JMP_IOS_EXPORTER_CONFIG}    selector=${JMP_IOS_SELECTOR}    lease_name=${JMP_IOS_LEASE_NAME}    config=${JMP_IOS_CLIENT_CONFIG}    AS    session.ios
Library    jumpstarter_robot.Driver    simulator.ios    client=jumpstarter_driver_iosdevice.client.IosDeviceClient    prefix=Simulator Ios    session=ios    AS    ios.simulator.ios
Library    jumpstarter_robot.Driver    simulator.power    client=jumpstarter_driver_power.client.VirtualPowerClient    prefix=Device Power    session=ios    AS    ios.simulator.power
Library    jumpstarter_robot.Driver    simulator.appium    client=jumpstarter_driver_appium.client.AppiumClient    prefix=Appium    session=ios    AS    ios.simulator.appium

*** Variables ***
${JMP_IOS_EXPORTER_CONFIG}    ${CURDIR}/exporter-ios.yaml
${JMP_IOS_SELECTOR}    ${EMPTY}
${JMP_IOS_LEASE_NAME}    ${EMPTY}
${JMP_IOS_CLIENT_CONFIG}    ${EMPTY}
