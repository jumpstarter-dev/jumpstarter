*** Settings ***
Documentation    Generated by `jmp robot generate` from exporter config ../basic/exporter.yaml (device MockBench, session board). Do not edit: regenerating overwrites it.
Library    jumpstarter_robot.Jumpstarter    auto_import=False
Library    jumpstarter_robot.Session    board    exporter_config=${JMP_BOARD_EXPORTER_CONFIG}    selector=${JMP_BOARD_SELECTOR}    lease_name=${JMP_BOARD_LEASE_NAME}    config=${JMP_BOARD_CLIENT_CONFIG}    AS    session.board
Library    jumpstarter_robot.Driver    dut    client=jumpstarter_example_robot.client.MockDutClient    prefix=Dut    session=board    AS    board.dut
Library    jumpstarter_robot.Driver    dut.power    client=jumpstarter_driver_power.client.PowerClient    prefix=Dut Power    session=board    AS    board.dut.power
Library    jumpstarter_robot.Driver    dut.console    client=jumpstarter_driver_network.client.NetworkClient    prefix=Dut Console    session=board    AS    board.dut.console
Library    jumpstarter_robot.Driver    storage    client=jumpstarter_driver_opendal.client.StorageMuxFlasherClient    prefix=Storage    session=board    AS    board.storage
Library    jumpstarter_robot.Driver    shell    client=jumpstarter_driver_shell.client.ShellClient    prefix=Shell    session=board    methods=hello,fail    AS    board.shell

*** Variables ***
${JMP_BOARD_EXPORTER_CONFIG}    ${CURDIR}/../basic/exporter.yaml
${JMP_BOARD_SELECTOR}    ${EMPTY}
${JMP_BOARD_LEASE_NAME}    ${EMPTY}
${JMP_BOARD_CLIENT_CONFIG}    ${EMPTY}
