*** Settings ***
Documentation    Generated by `jmp robot generate` from exporter config exporter.yaml (device MockPair, session multi). Do not edit: regenerating overwrites it.
Library    jumpstarter_robot.Jumpstarter    auto_import=False
Library    jumpstarter_robot.Session    multi    exporter_config=${JMP_MULTI_EXPORTER_CONFIG}    selector=${JMP_MULTI_SELECTOR}    lease_name=${JMP_MULTI_LEASE_NAME}    config=${JMP_MULTI_CLIENT_CONFIG}    AS    session.multi
Library    jumpstarter_robot.Driver    dut1    client=jumpstarter_example_robot.client.MockDutClient    prefix=Dut1    session=multi    AS    multi.dut1
Library    jumpstarter_robot.Driver    dut2    client=jumpstarter_example_robot.client.MockDutClient    prefix=Dut2    session=multi    AS    multi.dut2
Library    jumpstarter_robot.Driver    dut1.power    role=power    client=jumpstarter_driver_power.client.PowerClient    prefix=Power    session=multi    AS    multi.power
Library    jumpstarter_robot.Driver    dut1.console    role=console    client=jumpstarter_driver_network.client.NetworkClient    prefix=Console    session=multi    AS    multi.console

*** Variables ***
${JMP_MULTI_EXPORTER_CONFIG}    ${CURDIR}/exporter.yaml
${JMP_MULTI_SELECTOR}    ${EMPTY}
${JMP_MULTI_LEASE_NAME}    ${EMPTY}
${JMP_MULTI_CLIENT_CONFIG}    ${EMPTY}
@{MULTI_DEVICES}    dut1    dut2
